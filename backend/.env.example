# Copy this file to .env and fill in what you have. Everything is optional —
# the app runs fully without any keys, using local heuristic fallbacks
# instead of cloud AI where a key is missing.

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_video_editor

# --- Storage ---
MEDIA_DIR=./media

# --- Cloud AI providers (optional) ---
# Used for: transcription (Whisper API), highlight scoring, viral score
# reasoning, titles/description/hashtags, translation.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Used only if requirements-ml.txt is installed and you want local
# pyannote.audio speaker diarization instead of the heuristic fallback.
HF_TOKEN=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
